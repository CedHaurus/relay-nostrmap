/var/log/strfry-monitor.log /var/log/server-backup.log {
    su root adm
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

/var/log/relay-hourly.tsv {
    su root adm
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}

